{
  "name": "openchamber-monorepo",
  "version": "1.6.5",
  "description": "OpenChamber PWA with NestJS backend for OpenCode AI coding agent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "ai",
    "coding",
    "openchamber",
    "cli"
  ],
  "author": "Bohdan Triapitsyn",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n \"server,pwa\" -c \"cyan,magenta\" \"bun run --cwd packages/server dev\" \"bun run --cwd packages/pwa dev\"",
    "build": "bun run --filter '*' build",
    "build:server": "bun run --cwd packages/server build",
    "build:pwa": "bun run --cwd packages/pwa build",
    "test": "bun run --filter '*' test",
    "test:server": "bun run --cwd packages/server test",
    "test:pwa": "bun run --cwd packages/pwa test",
    "test:cov": "bun run --filter '*' test:cov",
    "test:e2e": "bun run --filter '*' test:e2e",
    "type-check": "bun run --filter '*' type-check",
    "type-check:server": "bun run --cwd packages/server type-check",
    "type-check:pwa": "bun run --cwd packages/pwa type-check",
    "lint": "bun run --filter '*' lint",
    "lint:server": "bun run --cwd packages/server lint",
    "lint:pwa": "bun run --cwd packages/pwa lint",
    "clean": "bun run --filter '*' clean",
    "start": "bun run --cwd packages/server start:prod"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.3.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.8.3"
  }
}
