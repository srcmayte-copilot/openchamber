{
  "name": "openchamber-monorepo",
  "version": "1.6.5",
  "description": "OpenChamber PWA with NestJS backend for OpenCode AI coding agent",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "ai",
    "coding",
    "openchamber",
    "cli"
  ],
  "author": "Bohdan Triapitsyn",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n \"server,pwa\" -c \"cyan,magenta\" \"npm run --workspace=packages/server dev\" \"npm run --workspace=packages/pwa dev\"",
    "build": "npm run --workspaces build",
    "build:server": "npm run --workspace=packages/server build",
    "build:pwa": "npm run --workspace=packages/pwa build",
    "test": "npm run --workspaces --if-present test",
    "test:server": "npm run --workspace=packages/server test",
    "test:pwa": "npm run --workspace=packages/pwa test",
    "test:cov": "npm run --workspaces --if-present test:cov",
    "test:e2e": "npm run --workspaces --if-present test:e2e",
    "type-check": "npm run --workspaces --if-present type-check",
    "type-check:server": "npm run --workspace=packages/server type-check",
    "type-check:pwa": "npm run --workspace=packages/pwa type-check",
    "lint": "npm run --workspaces --if-present lint",
    "lint:server": "npm run --workspace=packages/server lint",
    "lint:pwa": "npm run --workspace=packages/pwa lint",
    "clean": "npm run --workspaces --if-present clean",
    "start": "npm run --workspace=packages/server start:prod"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.3.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.8.3"
  }
}
